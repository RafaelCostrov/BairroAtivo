{
  "name": "bairroativo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "mobile",
    "shared"
  ],
  "scripts": {
    "db:inspect": "npm run inspect -w server",
    "db:migrate": "npm run migrate -w server",
    "db:seed": "npm run seed -w server",
    "db:test": "npm run test:oracle -w server",
    "user:role": "npm run role -w server --",
    "start:api": "npm start -w server",
    "start:mobile": "npm start -w mobile --",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint server shared mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test -w server",
    "test:integration": "npm run test:integration -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.8.0",
    "react": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "overrides": {
    "react": "19.3.0"
  }
}
